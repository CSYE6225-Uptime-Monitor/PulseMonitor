PORT=8080
NODE_ENV=development
SESSION_SECRET=local-dev-session-secret-not-for-production-use
USERS_TABLE=pulsemonitor-dev-users
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT=http://localhost:4566

# LocalStack ignores these values but the AWS SDK still requires something to
# be set. Do not use real credentials here. In deployed environments the EC2
# instance role supplies credentials instead of these variables.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
