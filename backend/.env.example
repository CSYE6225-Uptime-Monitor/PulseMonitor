PORT=8080
NODE_ENV=development
SESSION_SECRET=change-me-to-a-long-random-string
USERS_TABLE=pulsemonitor-dev-users
SITES_TABLE=pulsemonitor-dev-sites
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT=http://localhost:8000
HISTORY_BUCKET=pulsemonitor-dev-monitoring-history-000000000000
HISTORY_PREFIX=sites
S3_ENDPOINT=http://localhost:8000

# DynamoDB Local ignores these values but the AWS SDK still requires something
# to be set. Do not use real credentials here. In deployed environments the
# EC2 instance role supplies credentials instead of these variables.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
